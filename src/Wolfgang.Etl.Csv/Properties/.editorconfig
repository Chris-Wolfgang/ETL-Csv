# Per-folder analyzer suppressions for the polyfill attributes under
# src/Wolfgang.Etl.Csv/Properties/. Every suppression is scoped to this
# folder only and documented — remove the block rather than expanding
# its scope if the underlying code changes.

[*.cs]

# CheckNamespace: the polyfills MUST declare the same namespace as the
# real attribute in modern .NET (e.g. System.Diagnostics.CodeAnalysis,
# System.Runtime.CompilerServices) so that consumer code referencing
# [DynamicallyAccessedMembers], [RequiresUnreferencedCode], init-only
# setters, etc. binds to our shim on older TFMs. The folder-based
# convention CheckNamespace wants (Wolfgang.Etl.Csv.Properties) would
# break the polyfill contract.
resharper_check_namespace_highlighting = none

# UnusedAutoPropertyAccessor.Global: polyfill attributes mirror the
# public surface of the real .NET attributes so consumer code compiles
# identically on old and new TFMs. Even accessors we don't read
# ourselves must be kept because consumer code may read them via
# reflection (analyzers, source generators, trimmer). Removing them
# would silently break third-party tooling on older TFMs.
resharper_unused_auto_property_accessor_global_highlighting = none
