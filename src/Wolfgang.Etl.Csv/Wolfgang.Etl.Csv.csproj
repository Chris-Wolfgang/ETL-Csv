<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net462;netstandard2.0;netstandard2.1;net5.0;net6.0;net7.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.9.0</Version>
    <!-- Pin AssemblyVersion to MAJOR.MINOR.0.0 so .NET Framework consumers on
         the 0.7.x line don't need a binding redirect between PATCH bumps.
         Fleet convention for pre-1.0 libraries is "0.{Minor}.0.0" — only
         change on a MINOR bump (0.7.x -> 0.7.0.0) or MAJOR API change. -->
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <!-- PackageValidation (#156): fail the pack if the public surface breaks binary/source
         compatibility against the last published release. Bump the baseline to each newly
         shipped version as part of release prep. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.9.0</PackageValidationBaselineVersion>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Title>Wolfgang.Etl.Csv</Title>
    <Authors>Chris Wolfgang</Authors>
    <Description>CsvExtractor and CsvLoader implementations for reading and writing CSV files, built on Wolfgang.Etl.Abstractions and CsvHelper.</Description>
    <Copyright>Copyright 2026 Chris Wolfgang</Copyright>
    <PackageProjectUrl>https://github.com/Chris-Wolfgang/ETL-Csv</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Chris-Wolfgang/ETL-Csv</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>False</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SignAssembly>False</SignAssembly>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <PackageTags>ETL;Extract-Transform-Load;CSV;CsvHelper</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <PackageIcon>icon_256.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon_256.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md" Condition="Exists('..\..\README.md')">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Condition="Exists('..\..\THIRD-PARTY-NOTICES.md')">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Wolfgang.Etl.Abstractions" Version="0.24.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!-- Analyzer PackageReferences are centralized in Directory.Build.props -->

  <!-- PublicApiAnalyzers: the public surface diverges by TFM. Every options/report record derives from an
       Abstractions record, and its compiler-synthesized <Clone>$ has a covariant return (the derived type) on
       net5.0+ but returns the base type on net462 / netstandard2.0. The shared PublicAPI.Shipped.txt (wired in
       Directory.Build.props) holds the TFM-invariant surface; these per-TFM files carry the divergent entries. -->
  <ItemGroup>
    <AdditionalFiles Include="PublicApi\modern\PublicAPI.Shipped.txt"
                     Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net5.0'))" />
    <AdditionalFiles Include="PublicApi\modern\PublicAPI.Unshipped.txt"
                     Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net5.0'))" />
    <AdditionalFiles Include="PublicApi\legacy\PublicAPI.Shipped.txt"
                     Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net5.0'))" />
    <AdditionalFiles Include="PublicApi\legacy\PublicAPI.Unshipped.txt"
                     Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net5.0'))" />
  </ItemGroup>

</Project>
