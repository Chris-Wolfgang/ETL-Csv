      },
      "version": "",
      "Uid": null,
      "IsMRef": true,
      "Title": "Wolfgang.Etl.Csv.CsvColumnMap",
      "Summary": "<p sourcefile=\"api/Wolfgang.Etl.Csv.CsvColumnMap.yml\" sourcestartlinenumber=\"1\">Runtime descriptor for a single property-to-column mapping. The parser-agnostic\nequivalent of <xref href=\"Wolfgang.Etl.Csv.CsvColumnAttribute\" data-throw-if-not-resolved=\"false\"></xref> for cases where the layout isn't\nknown until runtime (for example, layout selected from configuration or a database).</p>\n"
    },
    {
      "type": "ManagedReference",
      "source_relative_path": "api/Wolfgang.Etl.Csv.CsvDiscriminator-1.yml",
      "output": {
        ".html": {
