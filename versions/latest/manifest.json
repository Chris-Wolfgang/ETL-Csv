      "version": "",
      "Uid": null,
      "IsMRef": true,
      "Title": "Wolfgang.Etl.Csv.CsvValidationResult",
      "Summary": "<p sourcefile=\"api/Wolfgang.Etl.Csv.CsvValidationResult.yml\" sourcestartlinenumber=\"1\">The outcome of running a <xref href=\"Wolfgang.Etl.Csv.CsvValidator%601\" data-throw-if-not-resolved=\"false\"></xref> against a record: whether it passed and, if\nnot, the human-readable reasons it failed.</p>\n"
    },
