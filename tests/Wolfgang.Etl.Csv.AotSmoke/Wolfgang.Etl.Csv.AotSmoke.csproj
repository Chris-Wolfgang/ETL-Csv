<Project Sdk="Microsoft.NET.Sdk">

  <!-- AOT / trim smoke consumer (#76). Deliberately OUT of ETL-Csv.slnx: it is
       net10.0 Native-AOT only and is published+run solely by aot.yaml on Linux,
       so it must not join the multi-TFM solution build (which also runs on
       Windows, where the AOT toolchain is unavailable). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>   <!-- implied by AOT; explicit so this reads as a trim + AOT check (#76) -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- The repo-wide Release TreatWarningsAsErrors applies: the library's own reflection
         path is annotated at its public boundary ([RequiresUnreferencedCode] /
         [RequiresDynamicCode]) and Program.cs suppresses those at its call sites, so any
         new trim/AOT warning from Wolfgang.Etl.Csv fails the publish.
         These codes come from CsvHelper's reflection-based mapping inside CsvHelper.dll
         (IL2070 x7, IL2075 x2, IL3050 x5 in a win-x64 publish), not from this library;
         they stay warnings until a compile-time class map removes the CsvHelper reflection
         path: https://github.com/Chris-Wolfgang/ETL-Csv/issues/5 -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL2070;IL2075;IL3050</WarningsNotAsErrors>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.Etl.Csv\Wolfgang.Etl.Csv.csproj" />
  </ItemGroup>

</Project>
