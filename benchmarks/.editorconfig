# Analyzer rules relaxed for benchmark projects

[*.cs]

# AsyncFixer01: Remove async/await — benchmark methods use BenchmarkDotNet conventions
dotnet_diagnostic.AsyncFixer01.severity = none

# MA0004: Use ConfigureAwait(false) — not needed in benchmark harness
dotnet_diagnostic.MA0004.severity = none

# S1215: Remove use of GC.GetTotalMemory — required for memory benchmarks
dotnet_diagnostic.S1215.severity = none

# VSTHRD200: Use Async suffix — benchmark methods follow BenchmarkDotNet naming conventions
dotnet_diagnostic.VSTHRD200.severity = none

# NotAccessedVariable fires on the dead-store `count` inside benchmark
# hot loops that assigns a value to keep the JIT from eliding the work
# being measured (MemoryDeltaBenchmarks.cs:58 pattern). Removing the
# store would defeat the benchmark; the assignment is the benchmark.
dotnet_diagnostic.NotAccessedVariable.severity = none

# RS0016/RS0017/RS0037 — PublicApiAnalyzers is loaded fleet-wide via
# Directory.Build.props but only meaningful for src/ projects that ship
# a public API. Benchmark projects don't ship. Same rationale as the
# tests/.editorconfig block. Belt-and-suspenders with the analyzer-load
# gate in Directory.Build.props (Exists('PublicAPI.*.txt')) — keeps the
# rule silenced if that gate ever regresses.
dotnet_diagnostic.RS0016.severity = none
dotnet_diagnostic.RS0017.severity = none
dotnet_diagnostic.RS0037.severity = none

# UnusedAutoPropertyAccessor.Global fires on BenchmarkDotNet [Params]
# properties whose setters BDN invokes reflectively from the harness
# rather than from user code. Not a real accessor "never called";
# scoped to benchmarks/ where the pattern is universal.
resharper_unused_auto_property_accessor_global_highlighting = none
